@@ -0,0 +1,44 @@
+# SpoolmanSync — Direct Mode (no Home Assistant)
+#
+# Runs SpoolmanSync alone, connecting straight to your printer's Moonraker
+# API instead of via Home Assistant + ha_creality_ws. See DIRECT_MODE.md for
+# what this does and does not confirm before relying on it.
+#
+# You still need a running Spoolman instance somewhere on your network —
+# this file does not bundle one (same as upstream's docker-compose.yml,
+# which also expects Spoolman to already exist and be configured via the
+# Settings page after first boot).
+#
+# Usage:
+#   docker compose -f docker-compose.direct.yml up -d
+#
+# Then open http://<this-host>:3000, go to Settings and connect Spoolman,
+# then go to Direct Printers and add your K2 Pro's Moonraker URL
+# (typically http://<printer-ip>:7125).
+
+services:
+  app:
+    build:
+      context: ./app
+      dockerfile: Dockerfile
+    container_name: spoolmansync-app-direct
+    ports:
+      - "3000:3000"
+    volumes:
+      - app-data-direct:/data
+    environment:
+      # No HA_MODE set on purpose — direct mode is determined entirely by
+      # whether at least one printer is configured on the Direct Printers
+      # page, not by an environment variable. This container never talks
+      # to Home Assistant regardless of what you configure.
+      - DIRECT_POLL_INTERVAL_MS=30000
+    restart: unless-stopped
+    networks:
+      - spoolmansync-direct
+
+volumes:
+  app-data-direct:
+
+networks:
+  spoolmansync-direct:
+    driver: bridge
-- 
