--- /dev/null
+++ b/app/src/lib/direct-poller.ts
@@ -0,0 +1,147 @@
+/**
+ * Direct-mode usage poller.
+ *
+ * Home Assistant's role in upstream SpoolmanSync isn't just discovery — its
+ * automations (homeassistant/automations.yaml) are what WATCH for tray/print
+ * state changes and POST `spool_usage` events to /api/webhook. Direct mode
+ * has no HA automations, so this poller replaces that trigger mechanism: it
+ * periodically reads each configured printer's CFS slot remaining-length
+ * directly from Moonraker, and when a slot's remaining length has dropped
+ * since the last poll, POSTs the same `spool_usage` webhook payload an HA
+ * automation would have sent — using `used_length` (cm) so the existing
+ * webhook handler's own `lengthToWeight()` conversion is reused unchanged.
+ *
+ * THIS IS NEW LOGIC, not part of upstream SpoolmanSync or ha_creality_ws.
+ * It has not been bench-verified against a real K2 Pro CFS. In particular:
+ * - It assumes `box.T{n}.remain_len` decreases monotonically during a print
+ *   and only increases when a spool is physically swapped/refilled. This is
+ *   a reasonable assumption, not a confirmed one.
+ * - Polling (default every 30s) means usage is attributed in discrete
+ *   chunks rather than in real time — acceptable for inventory tracking,
+ *   not for anything time-critical.
+ * - A power cycle or restart resets nothing destructively (baselines are
+ *   persisted to the Settings table every cycle), but a missed poll during
+ *   a very fast print could under-count if the printer's own state resets
+ *   the counter between polls. See DIRECT_MODE.md.
+ */
+import prisma from '@/lib/db';
+import { getDirectPrinterConfigs, DirectPrinterConfig } from '@/lib/direct-printers';
+import { queryMoonraker, synthesizeTrayId, prefixFromName, stripMaterialPrefix } from '@/lib/api/moonraker-direct';
+import { materialNameFor } from '@/lib/material-names';
+import { getWebhookSecret, WEBHOOK_TOKEN_HEADER } from '@/lib/webhook-secret';
+
+const BASELINE_SETTINGS_KEY = 'direct_poller_baselines';
+const DEFAULT_POLL_INTERVAL_MS = 30_000;
+const MIN_DELTA_METRES = 0.02; // ignore sub-2cm jitter as noise, not usage
+
+type BaselineMap = Record<string, number>; // `${printerId}:${trayNumber}` -> metres
+
+async function loadBaselines(): Promise<BaselineMap> {
+  const setting = await prisma.settings.findUnique({ where: { key: BASELINE_SETTINGS_KEY } });
+  if (!setting) return {};
+  try {
+    const parsed = JSON.parse(setting.value);
+    return typeof parsed === 'object' && parsed !== null ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+async function saveBaselines(baselines: BaselineMap): Promise<void> {
+  await prisma.settings.upsert({
+    where: { key: BASELINE_SETTINGS_KEY },
+    create: { key: BASELINE_SETTINGS_KEY, value: JSON.stringify(baselines) },
+    update: { value: JSON.stringify(baselines) },
+  });
+}
+
+function webhookBaseUrl(): string {
+  const port = process.env.PORT || '3000';
+  return `http://127.0.0.1:${port}`;
+}
+
+async function postUsageWebhook(activeTrayId: string, usedLengthCm: number, material: string | undefined): Promise<void> {
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+  const secret = await getWebhookSecret();
+  if (secret) headers[WEBHOOK_TOKEN_HEADER] = secret;
+
+  try {
+    await fetch(`${webhookBaseUrl()}/api/webhook`, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({
+        event: 'spool_usage',
+        active_tray_id: activeTrayId,
+        used_length: usedLengthCm,
+        material,
+      }),
+    });
+  } catch (err) {
+    console.error(`[direct-poller] Failed to post usage webhook for ${activeTrayId}:`, err);
+  }
+}
+
+async function pollOnce(): Promise<void> {
+  const configs = await getDirectPrinterConfigs();
+  if (configs.length === 0) return;
+
+  const baselines = await loadBaselines();
+  let baselinesChanged = false;
+
+  for (const config of configs) {
+    const result = await queryMoonraker(config.moonrakerUrl);
+    if (!result.box) continue; // printer offline/unreachable this cycle — skip, don't zero anything out
+
+    const prefix = prefixFromName(config.name);
+    const slots: Array<[number, { remain_len?: number; material_type?: string } | undefined]> = [
+      [1, result.box.T1], [2, result.box.T2], [3, result.box.T3], [4, result.box.T4],
+    ];
+
+    for (const [trayNumber, slot] of slots) {
+      if (!slot || typeof slot.remain_len !== 'number') continue;
+
+      const baselineKey = `${config.id}:${trayNumber}`;
+      const currentRemain = slot.remain_len;
+      const previousRemain = baselines[baselineKey];
+
+      if (typeof previousRemain !== 'number') {
+        // First observation of this slot — establish baseline, emit nothing.
+        baselines[baselineKey] = currentRemain;
+        baselinesChanged = true;
+        continue;
+      }
+
+      const deltaMetres = previousRemain - currentRemain;
+
+      if (deltaMetres > MIN_DELTA_METRES) {
+        const trayId = synthesizeTrayId(prefix, trayNumber);
+        const materialCode = stripMaterialPrefix(slot.material_type);
+        const materialName = materialCode ? materialNameFor(materialCode) : undefined;
+        await postUsageWebhook(trayId, deltaMetres * 100, materialName);
+      }
+      // Any outcome (usage, noise, or a refill/increase) resets the baseline
+      // to the current reading so the next cycle measures from here.
+      baselines[baselineKey] = currentRemain;
+      baselinesChanged = true;
+    }
+  }
+
+  if (baselinesChanged) {
+    await saveBaselines(baselines);
+  }
+}
+
+let pollTimer: ReturnType<typeof setInterval> | null = null;
+
+/** Starts the direct-mode poller. Safe to call multiple times — only one
+ * interval is ever active. No-op when no direct printers are configured;
+ * each cycle re-checks configuration, so enabling direct mode later doesn't
+ * require a restart. */
+export function startDirectPoller(): void {
+  if (pollTimer) return;
+  const intervalMs = Number(process.env.DIRECT_POLL_INTERVAL_MS) || DEFAULT_POLL_INTERVAL_MS;
+  pollTimer = setInterval(() => {
+    pollOnce().catch((err) => console.error('[direct-poller] Poll cycle failed:', err));
+  }, intervalMs);
+  console.log(`[direct-poller] Started, polling every ${intervalMs}ms`);
+}
