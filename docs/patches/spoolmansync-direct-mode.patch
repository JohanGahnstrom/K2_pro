diff --git a/app/src/instrumentation.ts b/app/src/instrumentation.ts
new file mode 100644
index 0000000..3f2cc30
--- /dev/null
+++ b/app/src/instrumentation.ts
@@ -0,0 +1,13 @@
+/**
+ * Next.js instrumentation hook — runs once when the server process starts.
+ * Used here only to boot the direct-mode usage poller (lib/direct-poller.ts).
+ * No-op in environments where direct mode isn't configured; the poller
+ * checks configuration on every cycle rather than requiring a restart.
+ * https://nextjs.org/docs/app/building-your-application/optimizing/instrumentation
+ */
+export async function register() {
+  if (process.env.NEXT_RUNTIME === 'nodejs') {
+    const { startDirectPoller } = await import('@/lib/direct-poller');
+    startDirectPoller();
+  }
+}
