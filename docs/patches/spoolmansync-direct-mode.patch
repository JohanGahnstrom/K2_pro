+import { describe, it, expect } from 'vitest';
+import { mapToHAPrinter, prefixFromName, synthesizeTrayId } from './moonraker-direct';
+import type { MoonrakerQueryResult } from './moonraker-direct';
+
+describe('prefixFromName', () => {
+  it('slugifies a printer name into a stable prefix', () => {
+    expect(prefixFromName('K2 Pro')).toBe('k2_pro');
+    expect(prefixFromName('  Office K2 Pro!  ')).toBe('office_k2_pro');
+    expect(prefixFromName('K2-Pro #2')).toBe('k2_pro_2');
+  });
+
+  it('never returns an empty string', () => {
+    expect(prefixFromName('!!!')).toBe('printer');
+  });
+});
+
+describe('synthesizeTrayId', () => {
+  it('is stable for the same prefix and slot number', () => {
+    expect(synthesizeTrayId('k2_pro', 1)).toBe('k2_pro_cfs_slot_1');
+    expect(synthesizeTrayId('k2_pro', 1)).toBe(synthesizeTrayId('k2_pro', 1));
+  });
+
+  it('differs across slots on the same printer', () => {
+    expect(synthesizeTrayId('k2_pro', 1)).not.toBe(synthesizeTrayId('k2_pro', 2));
+  });
+});
+
+describe('mapToHAPrinter', () => {
+  it('reports offline when Moonraker is unreachable', () => {
+    const result: MoonrakerQueryResult = { box: null, print_stats: null };
+    const printer = mapToHAPrinter('K2 Pro', 'k2_pro', result);
+    expect(printer.state).toBe('offline');
+    expect(printer.ams_units).toHaveLength(0);
+    expect(printer.brand).toBe('creality');
+  });
+
+  it('strips the documented format-digit prefixes from color and material', () => {
+    const result: MoonrakerQueryResult = {
+      box: {
+        T1: { color_value: '0FF0000', material_type: '101001', remain_len: 250, state: 'idle' },
+      },
+      print_stats: { state: 'standby' },
+    };
+    const printer = mapToHAPrinter('K2 Pro', 'k2_pro', result);
+    const slot = printer.ams_units[0].trays[0];
+    expect(slot.color).toBe('FF0000');
+    // material_type "101001" -> strip leading "1" -> "01001" -> HyperPLA
+    expect(slot.material).toBe('HyperPLA');
+    expect(slot.tray_uuid).toBeUndefined(); // no RFID serial available without ha_creality_ws
+  });
+
+  it('includes empty slots so they can still be assigned a spool', () => {
+    const result: MoonrakerQueryResult = {
+      box: { T1: undefined, T2: { color_value: undefined, material_type: undefined, remain_len: 0, state: 'empty' } },
+      print_stats: { state: 'standby' },
+    };
+    const printer = mapToHAPrinter('K2 Pro', 'k2_pro', result);
+    // T1 undefined -> not included; T2 present but empty -> included with no material/color
+    expect(printer.ams_units[0].trays).toHaveLength(1);
+    expect(printer.ams_units[0].trays[0].tray_number).toBe(2);
+    expect(printer.ams_units[0].trays[0].material).toBeUndefined();
+  });
+
+  it('produces the same synthetic tray ids that synthesizeTrayId would', () => {
+    const result: MoonrakerQueryResult = {
+      box: { T1: { color_value: '0000000', material_type: '100001', remain_len: 300 } },
+      print_stats: null,
+    };
+    const printer = mapToHAPrinter('K2 Pro', 'k2_pro', result);
+    expect(printer.ams_units[0].trays[0].unique_id).toBe(synthesizeTrayId('k2_pro', 1));
+  });
+});
diff --git a/app/src/lib/api/moonraker-direct.ts b/app/src/lib/api/moonraker-direct.ts
new file mode 100644
index 0000000..e58399d
--- /dev/null
+++ b/app/src/lib/api/moonraker-direct.ts
@@ -0,0 +1,192 @@
+/**
+ * Direct Moonraker client for CFS printer discovery — NO Home Assistant,
+ * NO ha_creality_ws. Queries the printer's Moonraker HTTP API directly.
+ *
+ * This is an additive alternative to lib/api/homeassistant.ts's
+ * discoverCrealityPrinters(), which requires Home Assistant + ha_creality_ws
+ * as an intermediary. Direct mode instead talks straight to Moonraker's
+ * `box` object, matching the same `HAPrinter`/`HATray`/`HAAMS` shapes so the
+ * rest of the app (spool matching, mismatch detection, dashboard rendering)
+ * needs no changes at all.
+ *
+ * IMPORTANT — what is and isn't confirmed here:
+ * - The `box` object field names below (color_value, material_type,
+ *   remain_len, temperature, state, auto_refill) come from community
+ *   reverse-engineering documented as CONFIRMED ON K2 PLUS. K2/K2 Pro are
+ *   marked untested in that same source. Treat this as high-probability,
+ *   not verified, until confirmed against real hardware.
+ * - Unlike ha_creality_ws, this direct client has NO independent way to read
+ *   a tag's RFID/serial number — that is exposed (if at all) through
+ *   Creality's own display-server protocol, not confirmed present in the
+ *   Moonraker `box` object. `tray_uuid` is therefore left undefined here;
+ *   RFID auto-match (matching a spool by its tag serial) is not available
+ *   in direct mode. Spool assignment still works by material/colour
+ *   matching and manual click-to-assign — it just can't auto-recognise a
+ *   tag the way the HA/ha_creality_ws path can.
+ * - Per-slot usage tracking (lib/direct-poller.ts) is NEW logic this fork
+ *   adds — it is not part of upstream SpoolmanSync or ha_creality_ws, and
+ *   has not been bench-verified against a real K2 Pro CFS. See
+ *   DIRECT_MODE.md.
+ */
+import { HAPrinter, HAAMS, HATray } from '@/lib/api/homeassistant';
+import { materialNameFor } from '@/lib/material-names';
+
+export interface MoonrakerBoxSlot {
+  color_value?: string;   // format "0RRGGBB"
+  material_type?: string; // format "1XXXXX"
+  remain_len?: number;    // metres remaining, per community docs
+  temperature?: number;
+  state?: string;
+}
+
+export interface MoonrakerBoxObject {
+  T1?: MoonrakerBoxSlot;
+  T2?: MoonrakerBoxSlot;
+  T3?: MoonrakerBoxSlot;
+  T4?: MoonrakerBoxSlot;
+  auto_refill?: boolean;
+  same_material?: unknown;
+  map?: unknown;
+}
+
+export interface MoonrakerPrintStats {
+  state?: string; // standby | printing | paused | complete | error | cancelled
+  filename?: string;
+  filament_used?: number; // mm, whole-printer total — not per-slot
+}
+
+export interface MoonrakerQueryResult {
+  box: MoonrakerBoxObject | null;
+  print_stats: MoonrakerPrintStats | null;
+}
+
+const REQUEST_TIMEOUT_MS = 4000;
+
+async function fetchWithTimeout(url: string, timeoutMs = REQUEST_TIMEOUT_MS): Promise<Response> {
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    return await fetch(url, { signal: controller.signal });
+  } finally {
+    clearTimeout(timeout);
+  }
+}
+
+/**
+ * Queries `box` and `print_stats` directly from Moonraker's HTTP API.
+ * Returns null fields (not a thrown error) on unreachable/offline printers
+ * so callers can render an "offline" state rather than failing the whole
+ * dashboard.
+ */
+export async function queryMoonraker(baseUrl: string): Promise<MoonrakerQueryResult> {
+  const clean = baseUrl.trim().replace(/\/+$/, '');
+  try {
+    const response = await fetchWithTimeout(`${clean}/printer/objects/query?box&print_stats`);
+    if (!response.ok) {
+      return { box: null, print_stats: null };
+    }
+    const json = await response.json();
+    const status = json?.result?.status ?? {};
+    return {
+      box: status.box ?? null,
+      print_stats: status.print_stats ?? null,
+    };
+  } catch {
+    return { box: null, print_stats: null };
+  }
+}
+
+/** Strips the community-documented leading format digit: "0RRGGBB" -> "RRGGBB". */
+function stripColorPrefix(value?: string): string | undefined {
+  if (!value) return undefined;
+  return value.length === 7 && value.startsWith('0') ? value.slice(1) : value;
+}
+
+/** Strips the community-documented leading format digit: "1XXXXX" -> "XXXXX". */
+export function stripMaterialPrefix(value?: string): string | undefined {
+  if (!value) return undefined;
+  return value.length === 6 && value.startsWith('1') ? value.slice(1) : value;
+}
+
+/** Builds the same synthetic entity_id/unique_id `slotToTray` uses, so the
+ * usage poller (lib/direct-poller.ts) can address the same tray keys that
+ * discovery produced. Centralised here to avoid the two staying in sync by
+ * accident. */
+export function synthesizeTrayId(prefix: string, trayNumber: number): string {
+  return `${prefix}_cfs_slot_${trayNumber}`;
+}
+
+function slotToTray(slot: MoonrakerBoxSlot | undefined, trayNumber: number, entityIdPrefix: string): HATray {
+  const materialCode = stripMaterialPrefix(slot?.material_type);
+  const colorHex = stripColorPrefix(slot?.color_value);
+  // Synthetic entity_id/unique_id: no real HA entity exists in direct mode,
+  // but the rest of the app keys spool assignments off these strings, so
+  // they must be stable across polls (same shape every time for the same
+  // physical slot).
+  const syntheticId = synthesizeTrayId(entityIdPrefix, trayNumber);
+  return {
+    entity_id: syntheticId,
+    unique_id: syntheticId,
+    tray_number: trayNumber,
+    name: materialCode ? materialNameFor(materialCode) : undefined,
+    color: colorHex,
+    material: materialCode ? materialNameFor(materialCode) : undefined,
+    tray_uuid: undefined, // not available without ha_creality_ws — see file header
+    remaining_weight: undefined, // computed separately by the usage poller, not discovery
+  };
+}
+
+/**
+ * Maps one printer's direct Moonraker query result into an `HAPrinter`.
+ * Slots with no material/colour reported (state absent or firmware not
+ * exposing a card) are still included as empty slots, matching the
+ * "assign a spool to an empty CFS slot" UX the dashboard already supports.
+ */
+export function mapToHAPrinter(name: string, prefix: string, result: MoonrakerQueryResult): HAPrinter {
+  const online = result.box !== null || result.print_stats !== null;
+  const trays: HATray[] = [];
+  if (result.box) {
+    const slots: Array<[number, MoonrakerBoxSlot | undefined]> = [
+      [1, result.box.T1], [2, result.box.T2], [3, result.box.T3], [4, result.box.T4],
+    ];
+    for (const [num, slot] of slots) {
+      if (slot !== undefined) trays.push(slotToTray(slot, num, prefix));
+    }
+  }
+
+  const ams: HAAMS[] = trays.length > 0
+    ? [{ entity_id: `${prefix}_cfs_box_1`, name: 'CFS', ams_number: 1, trays }]
+    : [];
+
+  return {
+    brand: 'creality',
+    entity_id: `${prefix}_print_status`,
+    name,
+    state: result.print_stats?.state || (online ? 'unknown' : 'offline'),
+    prefix,
+    ams_units: ams,
+    external_spools: [],
+  };
+}
+
+export function prefixFromName(name: string): string {
+  return name.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') || 'printer';
+}
+
+export interface DirectDiscoveryTarget {
+  name: string;
+  moonrakerUrl: string;
+}
+
+/** Discovers all configured direct-mode printers in parallel. Never throws —
+ * an unreachable printer comes back as an offline HAPrinter, same as any
+ * other transient network hiccup would look on the dashboard. */
+export async function discoverDirectPrinters(targets: DirectDiscoveryTarget[]): Promise<HAPrinter[]> {
+  const results = await Promise.all(
+    targets.map(async (target) => {
+      const result = await queryMoonraker(target.moonrakerUrl);
+      return mapToHAPrinter(target.name, prefixFromName(target.name), result);
+    })
+  );
+  return results;
+}
diff --git a/app/src/lib/direct-poller.ts b/app/src/lib/direct-poller.ts
