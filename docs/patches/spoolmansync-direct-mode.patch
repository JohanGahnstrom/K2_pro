@@ -0,0 +1,65 @@
+/**
+ * Direct-connect printer configuration (no Home Assistant).
+ *
+ * Stores a list of { name, moonrakerUrl } pairs in the existing generic
+ * `Settings` key/value table (no schema migration needed — same pattern
+ * `spool_filter_config` / `qr_base_url` already use). When this list is
+ * non-empty, `/api/printers` uses direct Moonraker discovery
+ * (lib/api/moonraker-direct.ts) instead of Home Assistant, and the poller
+ * (lib/direct-poller.ts) polls these printers directly for usage tracking.
+ */
+import prisma from '@/lib/db';
+
+const SETTINGS_KEY = 'direct_printers';
+
+export interface DirectPrinterConfig {
+  /** Stable id for this config entry (not a Moonraker/HA id — generated here). */
+  id: string;
+  /** Display name shown on the dashboard. */
+  name: string;
+  /** Moonraker base URL, e.g. http://192.168.1.50:7125 */
+  moonrakerUrl: string;
+}
+
+export async function getDirectPrinterConfigs(): Promise<DirectPrinterConfig[]> {
+  const setting = await prisma.settings.findUnique({ where: { key: SETTINGS_KEY } });
+  if (!setting) return [];
+  try {
+    const parsed = JSON.parse(setting.value);
+    if (!Array.isArray(parsed)) return [];
+    return parsed;
+  } catch {
+    return [];
+  }
+}
+
+export async function setDirectPrinterConfigs(configs: DirectPrinterConfig[]): Promise<void> {
+  await prisma.settings.upsert({
+    where: { key: SETTINGS_KEY },
+    create: { key: SETTINGS_KEY, value: JSON.stringify(configs) },
+    update: { value: JSON.stringify(configs) },
+  });
+}
+
+export async function isDirectModeEnabled(): Promise<boolean> {
+  const configs = await getDirectPrinterConfigs();
+  return configs.length > 0;
+}
+
+function randomId(): string {
+  return `direct_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;
+}
+
+export async function addDirectPrinter(name: string, moonrakerUrl: string): Promise<DirectPrinterConfig> {
+  const configs = await getDirectPrinterConfigs();
+  const cleanUrl = moonrakerUrl.trim().replace(/\/+$/, '');
+  const entry: DirectPrinterConfig = { id: randomId(), name: name.trim(), moonrakerUrl: cleanUrl };
+  configs.push(entry);
+  await setDirectPrinterConfigs(configs);
+  return entry;
+}
+
+export async function removeDirectPrinter(id: string): Promise<void> {
+  const configs = await getDirectPrinterConfigs();
+  await setDirectPrinterConfigs(configs.filter(c => c.id !== id));
+}
