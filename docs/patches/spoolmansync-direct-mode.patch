+/**
+ * Creality CFS material-code → display-name table.
+ *
+ * ha_creality_ws normally does this translation for you (it has its own
+ * material-database lookup baked in). Direct Moonraker mode has no such
+ * layer, so this is a minimal port of the same 41-entry table used in the
+ * OpenFilamentCFS Android project, itself ported from the community-verified
+ * DnG-Crafts/K2-RFID lineage (see that project's THIRD_PARTY.yml). Treat
+ * these as the verified set — if a real printer reports a code not in this
+ * table, fall back to the raw code rather than guessing a name.
+ */
+export const MATERIAL_NAMES: Record<string, string> = {
+  '10001': 'HP-TPU',
+  '11001': 'CR-Nylon',
+  '13001': 'CR-PLACarbon',
+  '14001': 'CR-PLAMatte',
+  '15001': 'CR-PLAFluo',
+  '16001': 'CR-TPU',
+  '17001': 'CR-Wood',
+  '18001': 'HPUltraPLA',
+  '19001': 'HP-ASA',
+  '07001': 'CR-ABS',
+  '06001': 'CR-PETG',
+  '04001': 'CR-PLA',
+  '05001': 'CR-Silk',
+  '09001': 'EN-PLA+',
+  '09002': 'ENDERFASTPLA',
+  '08001': 'Ender-PLA',
+  '00004': 'ABS',
+  '00007': 'ASA',
+  '00010': 'BVOH',
+  '00012': 'HIPS',
+  '00008': 'PA',
+  '00009': 'PA-CF',
+  '00015': 'PA6-CF',
+  '00016': 'PAHT-CF',
+  '00021': 'PC',
+  '00020': 'PET',
+  '00013': 'PET-CF',
+  '00003': 'PETG',
+  '00014': 'PETG-CF',
+  '00001': 'PLA',
+  '00006': 'PLA-CF',
+  '00002': 'PLA-Silk',
+  '00019': 'PP',
+  '00017': 'PPS',
+  '00018': 'PPS-CF',
+  '00011': 'PVA',
+  '00005': 'TPU',
+  '03001': 'HyperABS',
+  '06002': 'HyperPETG',
+  '01001': 'HyperPLA',
+  '02001': 'HyperPLA-CF',
+};
+
+/** Best-effort material name for display/matching. Returns the raw code
+ * (never a guessed name) when the code isn't in the verified table. */
+export function materialNameFor(code: string | undefined | null): string | undefined {
+  if (!code) return undefined;
+  return MATERIAL_NAMES[code] || code;
+}
