@@ -0,0 +1,156 @@
+'use client';
+
+import { useState, useEffect } from 'react';
+import { Nav } from '@/components/nav';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+import { Input } from '@/components/ui/input';
+import { Label } from '@/components/ui/label';
+import { toast } from 'sonner';
+
+interface DirectPrinterConfig {
+  id: string;
+  name: string;
+  moonrakerUrl: string;
+}
+
+export default function DirectPrintersPage() {
+  const [printers, setPrinters] = useState<DirectPrinterConfig[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [name, setName] = useState('');
+  const [moonrakerUrl, setMoonrakerUrl] = useState('');
+
+  useEffect(() => {
+    fetchSettings();
+  }, []);
+
+  const fetchSettings = async () => {
+    setLoading(true);
+    try {
+      const res = await fetch('/api/settings');
+      const data = await res.json();
+      setPrinters(data.directPrinters || []);
+    } catch (err) {
+      console.error('Failed to load direct printers:', err);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const addPrinter = async () => {
+    if (!name.trim() || !moonrakerUrl.trim()) {
+      toast.error('Name and Moonraker URL are both required');
+      return;
+    }
+    setSaving(true);
+    try {
+      const res = await fetch('/api/settings', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ type: 'direct_printer_add', name, moonrakerUrl }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        toast.error(data.error || 'Failed to add printer');
+        return;
+      }
+      toast.success(`${name} added`);
+      setName('');
+      setMoonrakerUrl('');
+      await fetchSettings();
+    } catch {
+      toast.error('Failed to add printer');
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const removePrinter = async (id: string, printerName: string) => {
+    try {
+      const res = await fetch('/api/settings', {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ type: 'direct_printer', id }),
+      });
+      if (!res.ok) {
+        toast.error('Failed to remove printer');
+        return;
+      }
+      toast.success(`${printerName} removed`);
+      await fetchSettings();
+    } catch {
+      toast.error('Failed to remove printer');
+    }
+  };
+
+  return (
+    <div className="min-h-screen bg-background">
+      <Nav />
+      <main className="w-full max-w-3xl mx-auto px-3 sm:px-4 md:px-6 py-6 space-y-6">
+        <div>
+          <h1 className="text-2xl font-bold">Direct Printers</h1>
+          <p className="text-sm text-muted-foreground mt-1">
+            Connect directly to a printer&apos;s Moonraker API — no Home Assistant, no
+            ha_creality_ws. Adding at least one printer here switches the whole app
+            to direct mode: the dashboard discovers CFS slots straight from Moonraker,
+            and a background poller (not an HA automation) tracks usage. See
+            DIRECT_MODE.md for what this does and does not confirm.
+          </p>
+        </div>
+
+        <Card>
+          <CardHeader>
+            <CardTitle>Add a printer</CardTitle>
+            <CardDescription>
+              The Moonraker URL is usually <code>http://&lt;printer-ip&gt;:7125</code>.
+            </CardDescription>
+          </CardHeader>
+          <CardContent className="space-y-3">
+            <div>
+              <Label htmlFor="printer-name">Name</Label>
+              <Input id="printer-name" placeholder="K2 Pro" value={name} onChange={(e) => setName(e.target.value)} />
+            </div>
+            <div>
+              <Label htmlFor="moonraker-url">Moonraker URL</Label>
+              <Input id="moonraker-url" placeholder="http://192.168.1.50:7125" value={moonrakerUrl} onChange={(e) => setMoonrakerUrl(e.target.value)} />
+            </div>
+            <Button onClick={addPrinter} disabled={saving}>
+              {saving ? 'Adding…' : 'Add printer'}
+            </Button>
+          </CardContent>
+        </Card>
+
+        <Card>
+          <CardHeader>
+            <CardTitle>Configured printers</CardTitle>
+          </CardHeader>
+          <CardContent>
+            {loading ? (
+              <p className="text-sm text-muted-foreground">Loading…</p>
+            ) : printers.length === 0 ? (
+              <p className="text-sm text-muted-foreground">
+                No direct printers configured yet. The dashboard will fall back to
+                Home Assistant discovery until you add one here.
+              </p>
+            ) : (
+              <ul className="space-y-2">
+                {printers.map((p) => (
+                  <li key={p.id} className="flex items-center justify-between rounded-md border p-3">
+                    <div>
+                      <div className="font-medium">{p.name}</div>
+                      <div className="text-xs text-muted-foreground">{p.moonrakerUrl}</div>
+                    </div>
+                    <Button variant="ghost" size="sm" onClick={() => removePrinter(p.id, p.name)}>
+                      Remove
+                    </Button>
+                  </li>
+                ))}
+              </ul>
+            )}
+          </CardContent>
+        </Card>
+      </main>
+    </div>
+  );
+}
